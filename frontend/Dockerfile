# build stage
ARG EXPO_PUBLIC_API_BASE=https://vocabuai.fryy.de/api
ARG APP_VERSION=0.2.2
ARG APP_COMMIT_SHA=local
ARG APP_BUILD_TIME_UTC=
ARG APP_BRANCH=local

FROM node:20-alpine AS build
ARG EXPO_PUBLIC_API_BASE
ARG APP_VERSION
ARG APP_COMMIT_SHA
ARG APP_BUILD_TIME_UTC
ARG APP_BRANCH
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . ./
ENV EXPO_PUBLIC_API_BASE=$EXPO_PUBLIC_API_BASE
ENV APP_VERSION=$APP_VERSION
ENV APP_COMMIT_SHA=$APP_COMMIT_SHA
ENV APP_BUILD_TIME_UTC=$APP_BUILD_TIME_UTC
ENV APP_BRANCH=$APP_BRANCH
RUN npm run build

# runtime stage
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
